# Valio Aimo mock API (required for live mode).
VALIO_API_URL=https://junction26.valioaimo.fi/api
VALIO_API_KEY=
VALIO_CUSTOMER=123

# live = call the mock API. recorded = replay the answers in fixtures/upstream (used by tests and evals).
VALIO_MODE=live

# Passcode the approver types to sign in to the console. Without it sign-in is open: use that only locally.
LAITURI_APPROVER_PASSCODE=
# One-click demo access: POST /api/v1/console/session {"demo": true} signs a visitor in as Nordic Harbour's approver
# without the passcode, and every approval or mandate change it makes says "demo access" in the audit log. off disables it.
LAITURI_DEMO_ACCESS=on
# Demo history: on an empty state at start-up, and after a demo reset, write about a week of signed trade by the three
# demo buyers through the real order path, marked seeded. off keeps a fresh start empty. Tests and evals turn it off.
LAITURI_SEED=on

# Optional. Folder for keys, the catalogue index and run state (default .data).
# LAITURI_DATA_DIR=
# Optional. Pause between the scripted buyer agent's steps in the demo scenes, in milliseconds (default 900).
# LAITURI_DEMO_STEP_MS=

# Optional. Engine for free-text console requests: auto (Claude, else Gemini, else scripted), claude, gemini or scripted.
# LAITURI_AGENT_ENGINE=auto
# Optional. Key for the Claude buyer agent; it is never shown to the model.
ANTHROPIC_API_KEY=
# Optional. Claude model for the buyer agent (default claude-sonnet-5-5).
# LAITURI_CLAUDE_MODEL=
# Optional. Key for the Gemini buyer agent; it is never shown to the model.
GEMINI_API_KEY=
# Optional. Gemini model for the buyer agent (default gemini-2.5-flash).
# LAITURI_GEMINI_MODEL=
# Optional. ElevenLabs key for spoken answers; it stays on the server. Without it the browser's own voice speaks.
ELEVENLABS_API_KEY=
# Optional. ElevenLabs voice id (default JBFqnCBsd6RMkjVDRZzb, "George").
# ELEVENLABS_VOICE_ID=
