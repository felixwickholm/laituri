# Valio Aimo mock API (required). The key is on the challenge page.
VALIO_API_URL=https://junction26.valioaimo.fi/api
VALIO_API_KEY=
VALIO_CUSTOMER=

# live = call the mock API. recorded = replay the fixtures in fixtures/upstream (used by tests and evals).
VALIO_MODE=live

# Optional. Without these the app uses local fallbacks.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
MONGODB_URI=
