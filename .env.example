# Valio Aimo mock API (required for live mode).
VALIO_API_URL=https://junction26.valioaimo.fi/api
VALIO_API_KEY=
VALIO_CUSTOMER=123

# live = call the mock API. recorded = replay the answers in fixtures/upstream (used by tests and evals).
VALIO_MODE=live

# Passcode the approver types to sign in to the console. Without it a production server offers no approver sign-in to
# the shared workspace; a local development server (NODE_ENV not production) signs anyone in.
LAITURI_APPROVER_PASSCODE=
# One-click demo access, in a visitor's own sandbox only: POST /api/v1/console/session {"demo": true} signs the browser in
# as Nordic Harbour's approver ({"demo": true, "role": "operator"}: as the wholesaler's operator) without a passcode, and
# every approval, mandate change or suspension it makes says "demo access" in the audit log. off disables it.
LAITURI_DEMO_ACCESS=on
# Demo history: on an empty state at start-up, and after a demo reset, write about a week of signed trade by the three
# demo buyers through the real order path, marked seeded. off keeps a fresh start empty. Tests and evals turn it off.
LAITURI_SEED=on

# Optional. Folder for keys, the catalogue index and run state (default .data).
# LAITURI_DATA_DIR=
# Optional. Pause between the scripted buyer agent's steps in the demo scenes, in milliseconds (default 900).
# LAITURI_DEMO_STEP_MS=

# Optional. Engine for free-text console requests: auto (Claude, else Gemini, else scripted), claude, gemini or scripted.
# LAITURI_AGENT_ENGINE=auto
# Optional. Key for the Claude buyer agent; it is never shown to the model.
ANTHROPIC_API_KEY=
# Optional. Claude model for the buyer agent (default claude-sonnet-5-5).
# LAITURI_CLAUDE_MODEL=
# Optional. Key for the Gemini buyer agent; it is never shown to the model.
GEMINI_API_KEY=
# Optional. Gemini model for the buyer agent (default gemini-2.5-flash).
# LAITURI_GEMINI_MODEL=
# Optional. ElevenLabs key for spoken answers; it stays on the server. Without it the browser's own voice speaks.
ELEVENLABS_API_KEY=
# Optional. ElevenLabs voice id (default JBFqnCBsd6RMkjVDRZzb, "George").
# ELEVENLABS_VOICE_ID=

# Optional. The most one quote line may ask for before it is refused as implausible (422 quantity_implausible), per unit.
# A line on untracked stock above a quarter of its ceiling waits for a person. Defaults: 20000 each.
# LAITURI_MAX_LINE_LITRES=20000
# LAITURI_MAX_LINE_KG=20000
# LAITURI_MAX_LINE_UNITS=20000

# Optional. Passcode the wholesaler's operator types to sign in (role "operator") and suspend or resume agents in the
# shared workspace. Without it, and without LAITURI_APPROVER_PASSCODE for the approver, a production server offers no
# sign-in to the shared workspace; only a local development server signs anyone in. Sandboxes also offer demo access.
LAITURI_OPERATOR_PASSCODE=
# Optional. Each browser gets a private in-memory sandbox copied from the seeded week. At most this many live at once;
# the least recently used is dropped first (default 300).
# LAITURI_SANDBOX_MAX=300
# Optional. Minutes an unused sandbox is kept before the next visit gets a fresh copy (default 60).
# LAITURI_SANDBOX_IDLE_MINUTES=60
